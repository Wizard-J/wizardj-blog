+function withSearchSources(answer, output) {
+  if (!output.some(item => item.type === 'web_search_call' && item.status === 'completed')) return answer;
+  const sources = new Map();
+  for (const item of output) {
+    for (const part of item.content ?? []) {
+      for (const source of part.annotations ?? []) {
+        if (source.type !== 'url_citation' || typeof source.url !== 'string') continue;
+        const url = URL.parse(source.url);
+        if (url && ['https:', 'http:'].includes(url.protocol) && !url.username && !url.password) {
+          sources.set(url.href, source.title?.replace(/\s+/gu, ' ').trim().slice(0, 120) || url.hostname);
+        }
+      }
+    }
+  }
+  if (!sources.size) return answer + '\n\n本次搜索未返回可核实的来源链接。';
+  const references = [...sources].slice(0, 5).map(([url, title], index) => `${index + 1}. ${title}\n${url}`);
+  return `${answer}\n\n来源\n${references.join('\n')}`;
+}
