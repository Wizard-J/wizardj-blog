WIZARDJ_STATE_DB=/var/lib/wizardj-blog-assistant/state/assistant.sqlite3
WIZARDJ_INTERNAL_TOKEN_FILE=/var/lib/wizardj-blog-assistant/secrets/internal-token
WIZARDJ_OPENAI_API_KEY_FILE=/var/lib/wizardj-blog-assistant/secrets/openai-key
WIZARDJ_OPENAI_PROJECT=
WIZARDJ_MODEL=gpt-6.1-sol
WIZARDJ_HUGO_BIN=/usr/local/bin/hugo
# Set to a separately configured SSH publishing host to enable publishing.
WIZARDJ_PUBLISH_HOST=
