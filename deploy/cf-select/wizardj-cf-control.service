[Unit]
Description=WizardJ node selection control socket

[Service]
User=root
Group=caddy
RuntimeDirectory=wizardj-cf-control
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/wizardj-egress/cf-control.env
ExecStart=/usr/bin/python3 /opt/wizardj-egress/cf_control.py
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/etc/wizardj-egress

[Install]
WantedBy=multi-user.target
